<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="MCQ ROOT AI" android:textColor="#FFFFFF"
            android:textSize="25sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Asisten belajar pilihan ganda • Manual + Screenshot OCR"
            android:textColor="#BDBDBD" android:layout_marginTop="5dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/apiKey" android:hint="OpenAI API key (disimpan lokal)"
            android:inputType="textPassword" android:textColor="#FFFFFF"
            android:hintTextColor="#888888" android:backgroundTint="#6750A4"
            android:layout_marginTop="20dp" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText android:id="@+id/question" android:hint="Ketik soal dan pilihan A, B, C, D di sini..."
            android:gravity="top|start" android:minLines="7" android:padding="12dp"
            android:textColor="#FFFFFF" android:hintTextColor="#888888"
            android:background="#242424" android:layout_marginTop="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/pickImage" android:text="Pilih Screenshot Soal"
            android:layout_marginTop="12dp" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button android:id="@+id/analyze" android:text="Analisis Jawaban"
            android:layout_marginTop="8dp" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button android:id="@+id/floating" android:text="Tampilkan Hasil Mengambang"
            android:layout_marginTop="8dp" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView android:text="HASIL ANALISIS" android:textColor="#C9B8FF"
            android:textStyle="bold" android:layout_marginTop="22dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/result" android:text="Hasil AI akan muncul di sini."
            android:textColor="#FFFFFF" android:textSize="16sp" android:padding="14dp"
            android:background="#242424" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
